# Comma-separated exact frontend origins. Wildcards are rejected.
A3_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
A3_ENVIRONMENT=development

# Optional limits. Defaults are suitable for the submitted application.
A3_MAX_CHARACTERS=10000
A3_MAX_BYTES=40000
A3_MAX_SENTENCES=100
A3_MAX_CONCURRENT_INFERENCES=2
A3_INFERENCE_QUEUE_TIMEOUT_SECONDS=0.05
A3_INFERENCE_TIMEOUT_SECONDS=15
A3_RATE_LIMIT_REQUESTS=60
A3_RATE_LIMIT_WINDOW_SECONDS=60

# Never disable the defence in normal use. The experiment script sets its own
# local-only process values and does not require these lines to be changed.
A3_EXPERIMENT_MODE=false
A3_DOS_PROTECTION_ENABLED=true
